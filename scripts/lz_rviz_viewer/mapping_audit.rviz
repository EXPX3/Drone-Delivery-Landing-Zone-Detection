Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Bayern DOP20 Orthophoto
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/audit/orthophoto
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.35
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 100; 110; 120
      Enabled: false
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.9
      Autocompute Intensity Bounds: false
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 250; 205
      Max Intensity: 3
      Min Color: 220; 30; 30
      Min Intensity: 0
      Name: Full Corrected LiDAR Scene (ground + obstacles)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/audit/direct_pointcloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.28
      Class: rviz_default_plugins/PointCloud2
      Color: 175; 180; 185
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Bayern Static Map PCD
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/audit/reference_ground
      Use Fixed Frame: true
      Value: false
    - Alpha: 0.85
      Class: rviz_default_plugins/PointCloud2
      Color: 40; 220; 210
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Corrected Update-Only Ground
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/audit/corrected_ground
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 70; 120
      Min Color: 255; 205; 40
      Name: Confirmed Scene Changes
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 5
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/audit/scene_changes
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 22; 27; 31
    Fixed Frame: lz_world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 180
      Focal Point:
        X: 58.6
        Y: -3.1
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.05
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.4
    Saved: ~
Window Geometry:
  Height: 950
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1600
  X: 0
  Y: 32

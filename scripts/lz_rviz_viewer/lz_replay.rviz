Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 353
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Point Cloud
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Bayern DOP20 Orthophoto
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.800000011920929
      Style: Squares
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/orthophoto
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.5
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 90; 100; 110
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.28
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 563.7239990234375
        Min Value: 548.4860229492188
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 230; 210; 80
      Max Intensity: 4096
      Min Color: 40; 90; 180
      Min Intensity: 0
      Name: Point Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.009999999776482582
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/pointcloud
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.72
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 60; 40
      Min Color: 30; 80; 255
      Name: Updated Live Map (Total)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.08
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/live_occupancy_points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      # Keep the most recent classified scan visible. Semantic objects in this
      # bag often contain only 3-10 Velodyne returns and otherwise disappear
      # between the lower-rate inference updates.
      Decay Time: 0
      Enabled: true
      Name: Semantic Obstacles
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 8
      Size (m): 0.32
      Style: Spheres
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/semantic_obstacles
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Landing Zones
      Namespaces:
        landing_zones_risky: true
        landing_zones_safe: true
        landing_zones_safest: true
        landing_zones_top30: true
        landing_zones_blocked: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/landing_zones
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Live Camera Geometry
      Namespaces:
        camera_footprint: true
        camera_frustum: true
        camera_visible_lz: true
        geographic_registration: true
        replay_sync: true
        semantic_covariance_1sigma: true
        semantic_covariance_2sigma: true
        semantic_covariance_3sigma: true
        semantic_gaussian_surface: true
        semantic_track_centroids: true
        semantic_track_labels: true
        uav: true
        uav_trajectory: true
        vision_only_covariance: true
        vision_only_labels: true
        vision_only_proposals: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ddlzd/replay_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 29; 34
    Fixed Frame: lz_world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 174.44888305664062
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 48.14995574951172
        Y: 12.055956840515137
        Z: 528.0872192382812
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.2199995517730713
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.13500849902629852
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Time:
    collapsed: false
  Views:
    collapsed: false
  Width: 1600
  X: 0
  Y: 32
